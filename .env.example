# Docker Compose - DEVELOPMENT LOKAL SAJA
# Salin menjadi .env di root. Jangan commit file .env yang berisi nilai asli.
APP_NAME="Study Buddy"
APP_ENV=local
APP_DEBUG=true
APP_KEY=
APP_URL=http://localhost:8000

# Database PostgreSQL internal Docker
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=study_buddy_db
DB_USERNAME=studybuddy_user
DB_PASSWORD=replace_with_your_local_db_password

# Cache & queue memakai Redis (service `redis`), fallback otomatis bila Redis mati
CACHE_STORE=failover
QUEUE_CONNECTION=failover
CACHE_PREFIX=studybuddy-cache-
CACHE_TTL=300
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=null

# Seeder admin - isi password unik pada file .env sebelum menjalankan db:seed
ADMIN_NAME="Study Buddy Admin"
ADMIN_EMAIL=admin@studybuddy.test
ADMIN_PASSWORD=replace_with_your_local_admin_password

# Frontend -> Next.js rewrite -> backend Laravel
NEXT_PUBLIC_API_URL=/api/v1
# Origin backend yang dilihat browser (= APP_URL); dipakai next/image untuk /storage
NEXT_PUBLIC_BACKEND_ORIGIN=http://localhost:8000
